import Mathlib.Analysis.SpecificLimits.Basic
import VariationalAnalysis.SCD.Regularity

/-!
# SCD semismoothness* and the SCD semismooth* Newton method

Following [Gfrerer–Outrata 2022, Section 5], `F : E ⇉ E` is *SCD semismooth** at `(x̄, ȳ)` if it
has the SCD property around `(x̄, ȳ)` and
`|⟪x*, x - x̄⟫ - ⟪y*, y - ȳ⟫| ≤ ε ‖(x, y) - (x̄, ȳ)‖ ‖(y*, x*)‖` for all `(x, y) ∈ gph F` near
`(x̄, ȳ)` and all `(y*, x*) ∈ ⋃ 𝒮*F(x, y)` (Def. 5.1). For the inclusion `0 ∈ F(x)` with solution
`x̄`, the SCD semismooth* Newton method (Algorithm 1) first computes `(x̂, ŷ) ∈ gph F` with
`‖(x̂, ŷ) - (x̄, 0)‖ ≤ η ‖x - x̄‖` and then sets `x⁺ = x̂ - C_Lᵀ ŷ` for some regular
`L ∈ 𝒮*F(x̂, ŷ)`, where `L = rge(C_L, I)` (Prop. 4.2).

## Norms

`E × E` carries the sup norm in Lean, while the paper uses the Euclidean norm on `ℝ²ⁿ`. The two
are equivalent (within the factor `√2`), so Def. 5.1 (a statement "for every `ε > 0`") is the same
property for both. In Prop. 5.3 we test (38) with the single pair `(C_L z, z)`,
`z = x - C_Lᵀ(y - ȳ) - x̄`, instead of a basis `(C_L eᵢ, eᵢ)`; this gives the sharper constant
`max 1 ‖C_L‖` in place of `√(n (1 + ‖C_L‖²))`, which removes the dependence on the dimension.
Since `max 1 c ≤ √(n (1 + c²))` and the sup norm is below the Euclidean norm, our estimate implies
(40). Superlinear convergence is stated as `‖x_{k+1} - x̄‖ = o(‖x_k - x̄‖)`, i.e. for every
`ε > 0` eventually `‖x_{k+1} - x̄‖ ≤ ε ‖x_k - x̄‖`.

## Main declarations

* `IsSCDSemismoothStarAt F p`, `IsSCDSemismoothStarAround F p`: [Gfrerer–Outrata 2022,
  Def. 5.1].
* `newtonApproxSet F x̄ η κ x`: the set `𝒢^{η,κ}_{F,x̄}(x)` of admissible approximation steps and
  subspaces [Gfrerer–Outrata 2022, p. 25]; `newtonApproxSet'` the same set without the regularity
  requirement and the bound `‖C_L‖ ≤ κ`, i.e. the right-hand side of (41).
* `newtonStep t`: the Newton step `x̂ - C_Lᵀ ŷ` of Algorithm 1 for `t = ((x̂, ŷ), L)`.
* `IsSCDNewtonSeq`, `IsSCDNewtonSeq'`: sequences generated by Algorithm 1 (as long as it does not
  stop) with choices in `𝒢^{η,κ}_{F,x̄}` (resp. any `L ∈ 𝒮*F(x̂, ŷ)`, as in Cor. 5.6).
* `SCDNewtonConverges F x̄ x`: the conclusion of Thm 5.4: linear contraction while the method has
  not stopped at a solution, and convergence to `x̄` with superlinear rate if it never stops.

## Main results

* `apply_adjoint_regularSubspaceOp`, `newtonDirection_eq`: the Newton direction computed from
  matrices `A, B` with `L = rge(Bᵀ, Aᵀ)` as in Algorithm 1 is `Δx = -C_Lᵀ ŷ`.
* `norm_sub_adjoint_le_of_forall`, `IsSCDSemismoothStarAt.eventually_norm_le`: Prop. 5.3.
* `IsSCDSemismoothStarAt.exists_newtonStep_le`: the one-step estimate behind Thm 5.4.
* `IsSCDSemismoothStarAt.scdNewton_converges`: Thm 5.4.
* `IsSCDRegularAround.eventually_newtonApproxSet`: Prop. 5.5.
* `IsSCDSemismoothStarAt.scdNewton_converges_of_isSCDRegularAround`: Cor. 5.6.
-/

open Filter Topology Set Module
open scoped InnerProductSpace NNReal ENNReal

namespace VariationalAnalysis

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
variable {F : E → Set E} {p : E × E}

/-! ### SCD semismoothness* -/

/-- `F` is SCD semismooth* at `p = (x̄, ȳ)` if it has the SCD property around `p` and for every
`ε > 0` the inequality `|⟪x*, x - x̄⟫ - ⟪y*, y - ȳ⟫| ≤ ε ‖(x, y) - (x̄, ȳ)‖ ‖(y*, x*)‖` holds for
all `(x, y) ∈ gph F` near `p` and all `(y*, x*) ∈ ⋃ 𝒮*F(x, y)` [Gfrerer–Outrata 2022, Def. 5.1].
-/
def IsSCDSemismoothStarAt (F : E → Set E) (p : E × E) : Prop :=
  HasSCDPropertyAround F p ∧ ∀ ε > 0, ∀ᶠ q in 𝓝 p, q ∈ graph F → ∀ L ∈ scCoderiv F q,
    ∀ w ∈ L, |⟪w.2, q.1 - p.1⟫_ℝ - ⟪w.1, q.2 - p.2⟫_ℝ| ≤ ε * ‖q - p‖ * ‖w‖

/-- `F` is SCD semismooth* around `p` if it is SCD semismooth* at every point of `gph F` near
`p` [Gfrerer–Outrata 2022, Def. 5.1]. -/
def IsSCDSemismoothStarAround (F : E → Set E) (p : E × E) : Prop :=
  ∃ W ∈ 𝓝 p, ∀ q ∈ graph F ∩ W, IsSCDSemismoothStarAt F q

/-- The `ε`-`δ` form of Def. 5.1 of [Gfrerer–Outrata 2022]. -/
theorem isSCDSemismoothStarAt_iff :
    IsSCDSemismoothStarAt F p ↔ HasSCDPropertyAround F p ∧ ∀ ε > 0, ∃ δ > 0, ∀ q ∈ graph F,
      ‖q - p‖ < δ → ∀ L ∈ scCoderiv F q, ∀ w ∈ L,
        |⟪w.2, q.1 - p.1⟫_ℝ - ⟪w.1, q.2 - p.2⟫_ℝ| ≤ ε * ‖q - p‖ * ‖w‖ := by
  refine and_congr_right fun _ ↦ forall₂_congr fun ε _ ↦ ?_
  rw [Metric.eventually_nhds_iff]
  simp only [dist_eq_norm]
  exact ⟨fun ⟨δ, hδ, h⟩ ↦ ⟨δ, hδ, fun q hq hqδ ↦ h hqδ hq⟩,
    fun ⟨δ, hδ, h⟩ ↦ ⟨δ, hδ, fun q hqδ hq ↦ h q hq hqδ⟩⟩

theorem IsSCDSemismoothStarAt.hasSCDPropertyAround (h : IsSCDSemismoothStarAt F p) :
    HasSCDPropertyAround F p := h.1

theorem IsSCDSemismoothStarAt.hasSCDPropertyAt (h : IsSCDSemismoothStarAt F p)
    (hp : p ∈ graph F) : HasSCDPropertyAt F p := by
  obtain ⟨U, hU, hscd⟩ := h.1
  exact hscd p ⟨hp, mem_of_mem_nhds hU⟩

theorem IsSCDSemismoothStarAround.isSCDSemismoothStarAt (h : IsSCDSemismoothStarAround F p)
    (hp : p ∈ graph F) : IsSCDSemismoothStarAt F p := by
  obtain ⟨W, hW, hss⟩ := h
  exact hss p ⟨hp, mem_of_mem_nhds hW⟩

/-- Semismoothness* around `p` propagates to all points of `gph F` near `p`. -/
theorem IsSCDSemismoothStarAround.eventually (h : IsSCDSemismoothStarAround F p) :
    ∀ᶠ q in 𝓝 p, q ∈ graph F → IsSCDSemismoothStarAround F q := by
  obtain ⟨W, hW, hss⟩ := h
  filter_upwards [eventually_mem_nhds_iff.2 hW] with q hq _
  exact ⟨W, hq, hss⟩

/-! ### The Newton direction -/

/-- The Newton direction of Algorithm 1 of [Gfrerer–Outrata 2022]: if `L = rge(Bᵀ, Aᵀ)` is
regular, then `A C_Lᵀ = B`, so `Δx = -C_Lᵀ ŷ` solves `A Δx = -B ŷ`. -/
theorem apply_adjoint_regularSubspaceOp {A B : E →L[ℝ] E}
    (hL : IsRegularSubspace (LinearMap.range
      ((ContinuousLinearMap.adjoint B : E →ₗ[ℝ] E).prod (ContinuousLinearMap.adjoint A)))) (y : E) :
    A (ContinuousLinearMap.adjoint (regularSubspaceOp (LinearMap.range
      ((ContinuousLinearMap.adjoint B : E →ₗ[ℝ] E).prod
        (ContinuousLinearMap.adjoint A : E →ₗ[ℝ] E)))) y) = B y := by
  refine ext_inner_right ℝ fun v ↦ ?_
  rw [← ContinuousLinearMap.adjoint_inner_right, ContinuousLinearMap.adjoint_inner_left]
  have h := hL.regularSubspaceOp_apply_snd v
  simp only [ContinuousLinearMap.coe_coe] at h
  rw [h, ContinuousLinearMap.adjoint_inner_right]

/-- The Newton direction of Algorithm 1 of [Gfrerer–Outrata 2022] is `Δx = -C_Lᵀ ŷ` when `A` is
injective, so that the new iterate is `x̂ + Δx = newtonStep ((x̂, ŷ), L)`. -/
theorem newtonDirection_eq {A B : E →L[ℝ] E}
    (hL : IsRegularSubspace (LinearMap.range
      ((ContinuousLinearMap.adjoint B : E →ₗ[ℝ] E).prod (ContinuousLinearMap.adjoint A))))
    (hA : Function.Injective A) {Δ y : E} (hΔ : A Δ = -B y) :
    Δ = -ContinuousLinearMap.adjoint (regularSubspaceOp (LinearMap.range
      ((ContinuousLinearMap.adjoint B : E →ₗ[ℝ] E).prod
        (ContinuousLinearMap.adjoint A : E →ₗ[ℝ] E)))) y := by
  refine hA ?_
  rw [map_neg, apply_adjoint_regularSubspaceOp hL, hΔ]

/-! ### Proposition 5.3 -/

/-- The pointwise content of Prop. 5.3 of [Gfrerer–Outrata 2022]: if (38) holds at `q` for all
elements of a regular subspace `L`, then
`‖q₁ - C_Lᵀ (q₂ - p₂) - p₁‖ ≤ ε max(1, ‖C_L‖) ‖q - p‖`. -/
theorem norm_sub_adjoint_le_of_forall {q : E × E} {L : Submodule ℝ (E × E)}
    (hL : IsRegularSubspace L) {ε : ℝ} (hε : 0 ≤ ε)
    (h : ∀ w ∈ L, |⟪w.2, q.1 - p.1⟫_ℝ - ⟪w.1, q.2 - p.2⟫_ℝ| ≤ ε * ‖q - p‖ * ‖w‖) :
    ‖q.1 - ContinuousLinearMap.adjoint (regularSubspaceOp L) (q.2 - p.2) - p.1‖ ≤
      ε * max 1 ‖regularSubspaceOp L‖ * ‖q - p‖ := by
  set C := regularSubspaceOp L
  obtain ⟨z, hz⟩ : ∃ z, z = q.1 - ContinuousLinearMap.adjoint C (q.2 - p.2) - p.1 := ⟨_, rfl⟩
  rw [← hz]
  have hw := h (C z, z) (hL.mk_mem z)
  have key : ⟪z, q.1 - p.1⟫_ℝ - ⟪C z, q.2 - p.2⟫_ℝ = ‖z‖ ^ 2 := by
    rw [← ContinuousLinearMap.adjoint_inner_right, ← inner_sub_right,
      ← real_inner_self_eq_norm_sq]
    congr 1
    rw [hz]
    abel
  simp only [key] at hw
  have hM : ‖((C z, z) : E × E)‖ ≤ max 1 ‖C‖ * ‖z‖ :=
    norm_prod_le_iff.2 ⟨(C.le_opNorm z).trans
      (mul_le_mul_of_nonneg_right (le_max_right _ _) (norm_nonneg _)),
      le_mul_of_one_le_left (norm_nonneg _) (le_max_left _ _)⟩
  have h2 : ‖z‖ * ‖z‖ ≤ (ε * max 1 ‖C‖ * ‖q - p‖) * ‖z‖ := by
    calc ‖z‖ * ‖z‖ = |‖z‖ ^ 2| := by rw [abs_of_nonneg (by positivity)]; ring
      _ ≤ ε * ‖q - p‖ * ‖((C z, z) : E × E)‖ := hw
      _ ≤ ε * ‖q - p‖ * (max 1 ‖C‖ * ‖z‖) := by gcongr
      _ = (ε * max 1 ‖C‖ * ‖q - p‖) * ‖z‖ := by ring
  rcases (norm_nonneg z).eq_or_lt with h0 | hpos
  · rw [← h0]
    have : 0 ≤ max 1 ‖C‖ := le_trans zero_le_one (le_max_left _ _)
    positivity
  · exact le_of_mul_le_mul_right h2 hpos

/-- Prop. 5.3 of [Gfrerer–Outrata 2022]: if `F` is SCD semismooth* at `p = (x̄, ȳ)`, then for
every `ε > 0` the estimate `‖x - C_Lᵀ (y - ȳ) - x̄‖ ≤ ε max(1, ‖C_L‖) ‖(x, y) - (x̄, ȳ)‖` holds
for all `(x, y) ∈ gph F` near `p` and all regular `L ∈ 𝒮*F(x, y)`. (The constant `max 1 ‖C_L‖`
improves `√(n (1 + ‖C_L‖²))` of (40), see the module docstring.) -/
theorem IsSCDSemismoothStarAt.eventually_norm_le (h : IsSCDSemismoothStarAt F p) {ε : ℝ}
    (hε : 0 < ε) :
    ∀ᶠ q in 𝓝 p, q ∈ graph F → ∀ L ∈ scCoderiv F q, IsRegularSubspace L →
      ‖q.1 - ContinuousLinearMap.adjoint (regularSubspaceOp L) (q.2 - p.2) - p.1‖ ≤
        ε * max 1 ‖regularSubspaceOp L‖ * ‖q - p‖ :=
  (h.2 ε hε).mono fun _ hq hqF L hL hreg ↦ norm_sub_adjoint_le_of_forall hreg hε.le (hq hqF L hL)

/-! ### The SCD semismooth* Newton method -/

/-- The set `𝒢^{η,κ}_{F,x̄}(x)` of [Gfrerer–Outrata 2022, p. 25]: triples `((x̂, ŷ), L)` with
`(x̂, ŷ) ∈ gph F`, `‖(x̂, ŷ) - (x̄, 0)‖ ≤ η ‖x - x̄‖`, `L ∈ 𝒮*F(x̂, ŷ) ∩ 𝓛ₙ^reg` and
`‖C_L‖ ≤ κ`. -/
def newtonApproxSet (F : E → Set E) (xbar : E) (η κ : ℝ) (x : E) :
    Set ((E × E) × Submodule ℝ (E × E)) :=
  {t | t.1 ∈ graph F ∧ ‖t.1 - (xbar, 0)‖ ≤ η * ‖x - xbar‖ ∧ t.2 ∈ scCoderiv F t.1 ∧
    IsRegularSubspace t.2 ∧ ‖regularSubspaceOp t.2‖ ≤ κ}

/-- The right-hand side of (41) in [Gfrerer–Outrata 2022]: `𝒢^{η,κ}_{F,x̄}(x)` without the
regularity requirement on `L` and the bound on `‖C_L‖`. -/
def newtonApproxSet' (F : E → Set E) (xbar : E) (η : ℝ) (x : E) :
    Set ((E × E) × Submodule ℝ (E × E)) :=
  {t | t.1 ∈ graph F ∧ ‖t.1 - (xbar, 0)‖ ≤ η * ‖x - xbar‖ ∧ t.2 ∈ scCoderiv F t.1}

theorem newtonApproxSet_subset (xbar : E) (η κ : ℝ) (x : E) :
    newtonApproxSet F xbar η κ x ⊆ newtonApproxSet' F xbar η x :=
  fun _ ht ↦ ⟨ht.1, ht.2.1, ht.2.2.1⟩

/-- The Newton step `x̂ - C_Lᵀ ŷ` of Algorithm 1 of [Gfrerer–Outrata 2022] for
`t = ((x̂, ŷ), L)`. -/
noncomputable def newtonStep (t : (E × E) × Submodule ℝ (E × E)) : E :=
  t.1.1 - ContinuousLinearMap.adjoint (regularSubspaceOp t.2) t.1.2

/-- `x` is generated by Algorithm 1 of [Gfrerer–Outrata 2022] with choices in
`𝒢^{η,κ}_{F,x̄}`: whenever `x_k` is not a solution, `x_{k+1} = x̂ - C_Lᵀ ŷ` for some
`((x̂, ŷ), L) ∈ 𝒢^{η,κ}_{F,x̄}(x_k)`. (If `0 ∈ F(x_k)` the algorithm stops, and the remaining
terms are irrelevant.) -/
def IsSCDNewtonSeq (F : E → Set E) (xbar : E) (η κ : ℝ) (x : ℕ → E) : Prop :=
  ∀ k, 0 ∉ F (x k) → ∃ t ∈ newtonApproxSet F xbar η κ (x k), x (k + 1) = newtonStep t

/-- `x` is generated by Algorithm 1 of [Gfrerer–Outrata 2022] with any approximation step
satisfying (39) and any `L ∈ 𝒮*F(x̂, ŷ)`, as in Cor. 5.6. -/
def IsSCDNewtonSeq' (F : E → Set E) (xbar : E) (η : ℝ) (x : ℕ → E) : Prop :=
  ∀ k, 0 ∉ F (x k) → ∃ t ∈ newtonApproxSet' F xbar η (x k), x (k + 1) = newtonStep t

theorem IsSCDNewtonSeq.isSCDNewtonSeq' {xbar : E} {η κ : ℝ} {x : ℕ → E}
    (h : IsSCDNewtonSeq F xbar η κ x) : IsSCDNewtonSeq' F xbar η x := fun k hk ↦ by
  obtain ⟨t, ht, hx⟩ := h k hk
  exact ⟨t, newtonApproxSet_subset xbar η κ _ ht, hx⟩

/-- The conclusion of Thm 5.4 of [Gfrerer–Outrata 2022] for a sequence `x`: as long as the
algorithm has not stopped at a solution, `‖x_k - x̄‖ ≤ 2⁻ᵏ ‖x_0 - x̄‖`; if it never stops, then
`x_k → x̄` superlinearly, i.e. `‖x_{k+1} - x̄‖ = o(‖x_k - x̄‖)`. -/
def SCDNewtonConverges (F : E → Set E) (xbar : E) (x : ℕ → E) : Prop :=
  (∀ k, (∀ j < k, 0 ∉ F (x j)) → ‖x k - xbar‖ ≤ (1 / 2) ^ k * ‖x 0 - xbar‖) ∧
    ((∀ k, 0 ∉ F (x k)) → Tendsto x atTop (𝓝 xbar) ∧
      ∀ ε > 0, ∀ᶠ k in atTop, ‖x (k + 1) - xbar‖ ≤ ε * ‖x k - xbar‖)

variable {xbar : E}

/-- The one-step estimate in the proof of Thm 5.4 of [Gfrerer–Outrata 2022]: under SCD
semismoothness* at `(x̄, 0)`, for every `ε > 0` there is `δ > 0` with
`‖x̂ - C_Lᵀ ŷ - x̄‖ ≤ ε ‖x - x̄‖` whenever `‖x - x̄‖ < δ` and `((x̂, ŷ), L) ∈ 𝒢^{η,κ}_{F,x̄}(x)`. -/
theorem IsSCDSemismoothStarAt.exists_newtonStep_le (h : IsSCDSemismoothStarAt F (xbar, 0))
    {η : ℝ} (hη : 0 < η) (κ : ℝ) {ε : ℝ} (hε : 0 < ε) :
    ∃ δ > 0, ∀ x, ‖x - xbar‖ < δ → ∀ t ∈ newtonApproxSet F xbar η κ x,
      ‖newtonStep t - xbar‖ ≤ ε * ‖x - xbar‖ := by
  set M := max 1 κ
  have hM : 0 < M := lt_of_lt_of_le zero_lt_one (le_max_left _ _)
  have hε' : 0 < ε / (M * η) := by positivity
  obtain ⟨δ, hδ, hball⟩ := Metric.eventually_nhds_iff.1 (h.eventually_norm_le hε')
  refine ⟨δ / η, by positivity, fun x hx t ht ↦ ?_⟩
  obtain ⟨hgph, hdist, hL, hreg, hC⟩ := ht
  have hlt : ‖t.1 - (xbar, 0)‖ < δ :=
    lt_of_le_of_lt hdist (by rwa [lt_div_iff₀' hη] at hx)
  have hest := hball (by rwa [dist_eq_norm]) hgph t.2 hL hreg
  simp only [sub_zero] at hest
  calc ‖newtonStep t - xbar‖
      ≤ ε / (M * η) * max 1 ‖regularSubspaceOp t.2‖ * ‖t.1 - (xbar, 0)‖ := hest
    _ ≤ ε / (M * η) * M * (η * ‖x - xbar‖) := by
        gcongr
        exact max_le_max le_rfl hC
    _ = ε * ‖x - xbar‖ := by field_simp

/-- The core of Thm 5.4 of [Gfrerer–Outrata 2022]: there is `δ > 0` such that, for every
`δ' ≤ δ`, every sequence starting in `B_{δ'}(x̄)` that performs Newton steps with choices in
`𝒢^{η,κ}_{F,x̄}` at its non-solution iterates in `B_{δ'}(x̄)` satisfies the conclusion of
Thm 5.4. -/
theorem IsSCDSemismoothStarAt.scdNewton_converges_aux (h : IsSCDSemismoothStarAt F (xbar, 0))
    {η : ℝ} (hη : 0 < η) (κ : ℝ) :
    ∃ δ > 0, ∀ δ' ≤ δ, ∀ x : ℕ → E, ‖x 0 - xbar‖ < δ' →
      (∀ k, ‖x k - xbar‖ < δ' → 0 ∉ F (x k) →
        ∃ t ∈ newtonApproxSet F xbar η κ (x k), x (k + 1) = newtonStep t) →
      SCDNewtonConverges F xbar x := by
  obtain ⟨δ, hδ, hest⟩ := h.exists_newtonStep_le hη κ (one_half_pos (α := ℝ))
  refine ⟨δ, hδ, fun δ' hδ' x hx0 hstep ↦ ?_⟩
  have hδ'pos : 0 < δ' := lt_of_le_of_lt (norm_nonneg _) hx0
  have hcontr : ∀ k, (∀ j < k, 0 ∉ F (x j)) → ‖x k - xbar‖ ≤ (1 / 2) ^ k * ‖x 0 - xbar‖ := by
    intro k
    induction k with
    | zero => intro _; simp
    | succ k ih =>
      intro hj
      have hk := ih fun j hj' ↦ hj j (Nat.lt_succ_of_lt hj')
      have hlt : ‖x k - xbar‖ < δ' := lt_of_le_of_lt (hk.trans (mul_le_of_le_one_left
        (norm_nonneg _) (pow_le_one₀ (by norm_num) (by norm_num)))) hx0
      obtain ⟨t, ht, hxt⟩ := hstep k hlt (hj k (Nat.lt_succ_self k))
      rw [hxt]
      calc ‖newtonStep t - xbar‖ ≤ 1 / 2 * ‖x k - xbar‖ := hest (x k) (hlt.trans_le hδ') t ht
        _ ≤ 1 / 2 * ((1 / 2) ^ k * ‖x 0 - xbar‖) := by gcongr
        _ = (1 / 2) ^ (k + 1) * ‖x 0 - xbar‖ := by ring
  refine ⟨hcontr, fun hns ↦ ?_⟩
  have hconv : Tendsto x atTop (𝓝 xbar) := by
    refine tendsto_iff_norm_sub_tendsto_zero.2 (squeeze_zero (fun _ ↦ norm_nonneg _)
      (fun k ↦ hcontr k fun j _ ↦ hns j) ?_)
    simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one (r := (1 / 2 : ℝ)) (by norm_num)
      (by norm_num)).mul_const ‖x 0 - xbar‖
  refine ⟨hconv, fun ε hε ↦ ?_⟩
  obtain ⟨δε, hδε, hestε⟩ := h.exists_newtonStep_le hη κ hε
  filter_upwards [(tendsto_iff_norm_sub_tendsto_zero.1 hconv).eventually
    (gt_mem_nhds (lt_min hδε hδ'pos))] with k hk
  obtain ⟨t, ht, hxt⟩ := hstep k (hk.trans_le (min_le_right _ _)) (hns k)
  rw [hxt]
  exact hestε _ (hk.trans_le (min_le_left _ _)) t ht

/-- Well-definedness of Algorithm 1 of [Gfrerer–Outrata 2022]: if `𝒢^{η,κ}_{F,x̄}(x) ≠ ∅` for
every non-solution `x ∈ B_r(x̄)`, then from every starting point close to `x̄` the algorithm
generates a sequence with choices in `𝒢^{η,κ}_{F,x̄}`. -/
theorem IsSCDSemismoothStarAt.exists_isSCDNewtonSeq (h : IsSCDSemismoothStarAt F (xbar, 0))
    {η : ℝ} (hη : 0 < η) (κ : ℝ) {r : ℝ} (hr : 0 < r)
    (hG : ∀ x, ‖x - xbar‖ < r → 0 ∉ F x → (newtonApproxSet F xbar η κ x).Nonempty) :
    ∃ δ > 0, ∀ x₀, ‖x₀ - xbar‖ < δ → ∃ x : ℕ → E, x 0 = x₀ ∧ IsSCDNewtonSeq F xbar η κ x := by
  classical
  obtain ⟨δ₁, hδ₁, hest⟩ := h.exists_newtonStep_le hη κ (one_half_pos (α := ℝ))
  refine ⟨min δ₁ r, lt_min hδ₁ hr, fun x₀ hx₀ ↦ ?_⟩
  let S : E → E := fun y ↦
    if hy : 0 ∉ F y ∧ (newtonApproxSet F xbar η κ y).Nonempty then newtonStep hy.2.some else y
  have hS : ∀ y, ‖y - xbar‖ < min δ₁ r → ‖S y - xbar‖ ≤ ‖y - xbar‖ := by
    intro y hy
    by_cases hc : 0 ∉ F y ∧ (newtonApproxSet F xbar η κ y).Nonempty
    · simp only [S, dif_pos hc]
      calc ‖newtonStep hc.2.some - xbar‖ ≤ 1 / 2 * ‖y - xbar‖ :=
            hest y (hy.trans_le (min_le_left _ _)) _ hc.2.some_mem
        _ ≤ ‖y - xbar‖ := by linarith [norm_nonneg (y - xbar)]
    · simp only [S, dif_neg hc, le_refl]
  have hbound : ∀ k, ‖S^[k] x₀ - xbar‖ ≤ ‖x₀ - xbar‖ := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      rw [Function.iterate_succ_apply']
      exact (hS _ (ih.trans_lt hx₀)).trans ih
  refine ⟨fun k ↦ S^[k] x₀, rfl, fun k hk ↦ ?_⟩
  have hlt : ‖S^[k] x₀ - xbar‖ < r := (hbound k).trans_lt (hx₀.trans_le (min_le_right _ _))
  have hc : 0 ∉ F (S^[k] x₀) ∧ (newtonApproxSet F xbar η κ (S^[k] x₀)).Nonempty :=
    ⟨hk, hG _ hlt hk⟩
  refine ⟨hc.2.some, hc.2.some_mem, ?_⟩
  show S^[k + 1] x₀ = _
  rw [Function.iterate_succ_apply']
  simp only [S, dif_pos hc]

/-- Thm 5.4 of [Gfrerer–Outrata 2022]: let `F` be SCD semismooth* at `(x̄, 0)` and let
`𝒢^{η,κ}_{F,x̄}(x) ≠ ∅` for every `x ∉ F⁻¹(0)` close to `x̄`. Then there is `δ > 0` such that from
every starting point `x₀ ∈ B_δ(x̄)` Algorithm 1 (with choices in `𝒢^{η,κ}_{F,x̄}`) is well
defined, and every such run either stops at a solution or converges superlinearly to `x̄`. -/
theorem IsSCDSemismoothStarAt.scdNewton_converges (h : IsSCDSemismoothStarAt F (xbar, 0))
    {η : ℝ} (hη : 0 < η) (κ : ℝ)
    (hG : ∀ᶠ x in 𝓝 xbar, 0 ∉ F x → (newtonApproxSet F xbar η κ x).Nonempty) :
    ∃ δ > 0, ∀ x₀, ‖x₀ - xbar‖ < δ →
      (∃ x : ℕ → E, x 0 = x₀ ∧ IsSCDNewtonSeq F xbar η κ x) ∧
      ∀ x : ℕ → E, x 0 = x₀ → IsSCDNewtonSeq F xbar η κ x → SCDNewtonConverges F xbar x := by
  obtain ⟨r, hr, hGr⟩ := Metric.eventually_nhds_iff.1 hG
  obtain ⟨δ₁, hδ₁, hex⟩ := h.exists_isSCDNewtonSeq hη κ hr
    fun x hx ↦ hGr (by rwa [dist_eq_norm])
  obtain ⟨δ₂, hδ₂, hconv⟩ := h.scdNewton_converges_aux hη κ
  refine ⟨min δ₁ δ₂, lt_min hδ₁ hδ₂, fun x₀ hx₀ ↦
    ⟨hex x₀ (hx₀.trans_le (min_le_left _ _)), fun x hx0 hseq ↦ ?_⟩⟩
  subst hx0
  exact hconv δ₂ le_rfl x (hx₀.trans_le (min_le_right _ _)) fun k _ hk ↦ hseq k hk

/-! ### Proposition 5.5 and Corollary 5.6 -/

/-- Prop. 5.5 of [Gfrerer–Outrata 2022]: if `F` is SCD regular around `(x̄, 0) ∈ gph F`, then for
every `η > 0` and every `κ > scdreg F(x̄, 0)`, for all `x` near `x̄` the set
`𝒢^{η,κ}_{F,x̄}(x)` is nonempty and equals the right-hand side of (41). -/
theorem IsSCDRegularAround.eventually_newtonApproxSet (h : IsSCDRegularAround F (xbar, 0))
    (hp : ((xbar, 0) : E × E) ∈ graph F) {η : ℝ} (hη : 0 < η) {κ : ℝ}
    (hκ : scdreg F (xbar, 0) < ENNReal.ofReal κ) :
    ∀ᶠ x in 𝓝 xbar, (newtonApproxSet F xbar η κ x).Nonempty ∧
      newtonApproxSet F xbar η κ x = newtonApproxSet' F xbar η x := by
  obtain ⟨ρ, hρ, hball⟩ := Metric.eventually_nhds_iff.1 (eventually_isRegularSubspace_and_norm_le hκ)
  obtain ⟨U, hU, hscd⟩ := h.1
  obtain ⟨L, hL⟩ := hasSCDPropertyAt_iff_scCoderiv_nonempty.1 (hscd _ ⟨hp, mem_of_mem_nhds hU⟩)
  refine Metric.eventually_nhds_iff.2 ⟨ρ / η, by positivity, fun x hx ↦ ⟨?_, ?_⟩⟩
  · refine ⟨((xbar, 0), L), hp, by simp only [sub_self, norm_zero]; positivity, hL,
      hball (by simpa using hρ) L hL⟩
  · refine Subset.antisymm (newtonApproxSet_subset xbar η κ x) fun t ht ↦ ⟨ht.1, ht.2.1, ht.2.2,
      hball ?_ t.2 ht.2.2⟩
    rw [dist_eq_norm]
    rw [dist_eq_norm, lt_div_iff₀' hη] at hx
    exact lt_of_le_of_lt ht.2.1 hx

/-- Cor. 5.6 of [Gfrerer–Outrata 2022]: if `F` is SCD semismooth* at `(x̄, 0) ∈ gph F` and SCD
regular around `(x̄, 0)`, then for every `η > 0` there is `δ > 0` such that from every starting
point `x₀ ∈ B_δ(x̄)` Algorithm 1 is well defined and, for any approximation steps satisfying (39)
and any choice of `L ∈ 𝒮*F(x̂, ŷ)`, either stops at a solution or converges superlinearly to
`x̄`. -/
theorem IsSCDSemismoothStarAt.scdNewton_converges_of_isSCDRegularAround
    (h : IsSCDSemismoothStarAt F (xbar, 0)) (hreg : IsSCDRegularAround F (xbar, 0))
    (hp : ((xbar, 0) : E × E) ∈ graph F) {η : ℝ} (hη : 0 < η) :
    ∃ δ > 0, ∀ x₀, ‖x₀ - xbar‖ < δ →
      (∃ x : ℕ → E, x 0 = x₀ ∧ IsSCDNewtonSeq' F xbar η x) ∧
      ∀ x : ℕ → E, x 0 = x₀ → IsSCDNewtonSeq' F xbar η x → SCDNewtonConverges F xbar x := by
  set κ := (scdreg F (xbar, 0)).toReal + 1
  have hκ : scdreg F (xbar, 0) < ENNReal.ofReal κ := by
    calc scdreg F (xbar, 0) = ENNReal.ofReal (scdreg F (xbar, 0)).toReal :=
          (ENNReal.ofReal_toReal hreg.scdreg_lt_top.ne).symm
      _ < ENNReal.ofReal κ := (ENNReal.ofReal_lt_ofReal_iff (by positivity)).2 (lt_add_one _)
  obtain ⟨ρ, hρ, hG⟩ := Metric.eventually_nhds_iff.1 (hreg.eventually_newtonApproxSet hp hη hκ)
  obtain ⟨δ₁, hδ₁, hex⟩ := h.exists_isSCDNewtonSeq hη κ hρ
    fun x hx _ ↦ (hG (by rwa [dist_eq_norm])).1
  obtain ⟨δ₂, hδ₂, hconv⟩ := h.scdNewton_converges_aux hη κ
  refine ⟨min δ₁ (min δ₂ ρ), lt_min hδ₁ (lt_min hδ₂ hρ), fun x₀ hx₀ ↦ ⟨?_, fun x hx0 hseq ↦ ?_⟩⟩
  · obtain ⟨x, hx0, hseq⟩ := hex x₀ (hx₀.trans_le (min_le_left _ _))
    exact ⟨x, hx0, hseq.isSCDNewtonSeq'⟩
  · subst hx0
    refine hconv (min δ₂ ρ) (min_le_left _ _) x (hx₀.trans_le (min_le_right _ _))
      fun k hk hns ↦ ?_
    obtain ⟨t, ht, hxt⟩ := hseq k hns
    have hk' : dist (x k) xbar < ρ := by
      rw [dist_eq_norm]; exact hk.trans_le (min_le_right _ _)
    exact ⟨t, (hG hk').2 ▸ ht, hxt⟩

end VariationalAnalysis
