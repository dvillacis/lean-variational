import Mathlib.Analysis.LocallyConvex.Separation
import VariationalAnalysis.Coderivative.SecondOrder

/-!
# Farkas' lemma for finitely many functionals

Farkas' lemma in a finite-dimensional normed space: if `⟨c, v⟩ ≥ 0` whenever `⟨aᵢ, v⟩ ≥ 0` for all
`i`, then `c = ∑ μᵢ aᵢ` with `μ ≥ 0`. It is the key to strong duality in linear optimization
(used, e.g., for the KKT and strong-duality reformulations of linear bilevel problems in
`lean-bilevel`).

## Main results

* `exists_nonneg_linearIndependent_sum_eq`: conic Carathéodory: a nonnegative combination of the
  `aᵢ` is a nonnegative combination with linearly independent support.
* `isClosed_nonnegSpan`: the cone generated by finitely many vectors of a normed space is closed.
* `exists_nonneg_eq_sum_of_forall_nonneg`: Farkas' lemma.

## Implementation notes

Mathlib has the geometric form of Farkas' lemma for closed cones (`ProperCone.hyperplane_separation`)
but not the closedness of finitely generated cones. Here closedness follows from conic
Carathéodory (a finitely generated cone is a finite union of images of orthants under injective
linear maps), and Farkas' lemma from the separation theorem
`geometric_hahn_banach_closed_point` together with the reflexivity of finite-dimensional spaces
(`inclusionInDoubleDual_surjective`).
-/

open Set

namespace VariationalAnalysis

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V]
  {ι : Type*} [Fintype ι]

omit [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V] in
/-- Conic Carathéodory: a nonnegative combination of the `aᵢ` is a nonnegative combination whose
support vectors are linearly independent. -/
theorem exists_nonneg_linearIndependent_sum_eq [AddCommGroup V] [Module ℝ V] (a : ι → V)
    (μ : ι → ℝ) (hμ : ∀ i, 0 ≤ μ i) :
    ∃ ν : ι → ℝ, (∀ i, 0 ≤ ν i) ∧ ∑ i, ν i • a i = ∑ i, μ i • a i ∧
      LinearIndependent ℝ fun i : {i // 0 < ν i} ↦ a i.1 := by
  classical
  suffices H : ∀ n, ∀ μ : ι → ℝ, (∀ i, 0 ≤ μ i) →
      (Finset.univ.filter fun i ↦ 0 < μ i).card = n →
      ∃ ν : ι → ℝ, (∀ i, 0 ≤ ν i) ∧ ∑ i, ν i • a i = ∑ i, μ i • a i ∧
        LinearIndependent ℝ fun i : {i // 0 < ν i} ↦ a i.1 from H _ μ hμ rfl
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro μ hμ hn
  by_cases hind : LinearIndependent ℝ fun i : {i // 0 < μ i} ↦ a i.1
  · exact ⟨μ, hμ, rfl, hind⟩
  obtain ⟨c₀, hc₀, i₀, hi₀⟩ := Fintype.not_linearIndependent_iff.1 hind
  -- a dependence on the support with a positive coefficient
  obtain ⟨c, hc, i₁, hi₁⟩ : ∃ c : {i // 0 < μ i} → ℝ, ∑ i, c i • a i.1 = 0 ∧ ∃ i, 0 < c i := by
    rcases hi₀.lt_or_gt with h | h
    · refine ⟨-c₀, ?_, i₀, by simpa using h⟩
      simp only [Pi.neg_apply, neg_smul, Finset.sum_neg_distrib, hc₀, neg_zero]
    · exact ⟨c₀, hc₀, i₀, h⟩
  obtain ⟨e, hep, hen⟩ : ∃ e : ι → ℝ, (∀ j (h : 0 < μ j), e j = c ⟨j, h⟩) ∧
      ∀ j, ¬ 0 < μ j → e j = 0 :=
    ⟨fun j ↦ if h : 0 < μ j then c ⟨j, h⟩ else 0, fun _ h ↦ dif_pos h, fun _ h ↦ dif_neg h⟩
  have hesum : ∑ j, e j • a j = 0 := by
    have hsplit := Fintype.sum_subtype_add_sum_subtype (fun j ↦ 0 < μ j) fun j ↦ e j • a j
    have h1 : ∑ j : {j // 0 < μ j}, e j.1 • a j.1 = 0 := by
      rw [← hc]
      exact Finset.sum_congr rfl fun j _ ↦ by rw [hep j.1 j.2]
    have h2 : ∑ j : {j // ¬ 0 < μ j}, e j.1 • a j.1 = 0 :=
      Finset.sum_eq_zero fun j _ ↦ by rw [hen j.1 j.2, zero_smul]
    rw [← hsplit, h1, h2, add_zero]
  -- the largest step `t` keeping `μ - t e ≥ 0`
  have hP : (Finset.univ.filter fun j ↦ 0 < e j).Nonempty :=
    ⟨i₁.1, Finset.mem_filter.2 ⟨Finset.mem_univ _, by rw [hep i₁.1 i₁.2]; exact hi₁⟩⟩
  obtain ⟨j₀, hj₀P, hj₀⟩ := (Finset.univ.filter fun j ↦ 0 < e j).exists_min_image
    (fun j ↦ μ j / e j) hP
  have hej₀ : 0 < e j₀ := (Finset.mem_filter.1 hj₀P).2
  set t := μ j₀ / e j₀ with ht_def
  have ht : 0 ≤ t := div_nonneg (hμ j₀) hej₀.le
  have hμ' : ∀ j, 0 ≤ μ j - t * e j := fun j ↦ by
    by_cases hj : 0 < e j
    · have h := hj₀ j (Finset.mem_filter.2 ⟨Finset.mem_univ _, hj⟩)
      rw [le_div_iff₀ hj] at h
      linarith
    · nlinarith [hμ j, not_lt.1 hj]
  have hsum' : ∑ j, (μ j - t * e j) • a j = ∑ j, μ j • a j := by
    simp only [sub_smul, Finset.sum_sub_distrib, mul_smul, ← Finset.smul_sum, hesum, smul_zero,
      sub_zero]
  have hsub : (Finset.univ.filter fun j ↦ 0 < μ j - t * e j) ⊂
      Finset.univ.filter fun j ↦ 0 < μ j := by
    refine (Finset.ssubset_iff_of_subset fun j hj ↦ ?_).2 ⟨j₀, ?_, ?_⟩
    · simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hj ⊢
      by_contra h
      rw [hen j h, mul_zero, sub_zero] at hj
      exact h hj
    · have : 0 < μ j₀ := by
        by_contra h
        exact hej₀.ne' (hen j₀ h)
      simpa using this
    · simp [ht_def, div_mul_cancel₀ _ hej₀.ne']
  obtain ⟨ν, hν, hνsum, hνind⟩ := ih _ (hn ▸ Finset.card_lt_card hsub) (fun j ↦ μ j - t * e j)
    hμ' rfl
  exact ⟨ν, hν, hνsum.trans hsum', hνind⟩

omit [FiniteDimensional ℝ V] in
/-- The cone generated by finitely many vectors of a normed space is closed. -/
theorem isClosed_nonnegSpan (a : ι → V) :
    IsClosed {v | ∃ μ : ι → ℝ, (∀ i, 0 ≤ μ i) ∧ v = ∑ i, μ i • a i} := by
  classical
  have e : {v | ∃ μ : ι → ℝ, (∀ i, 0 ≤ μ i) ∧ v = ∑ i, μ i • a i} =
      ⋃ S : Set ι, ⋃ (_ : LinearIndependent ℝ fun i : S ↦ a i.1),
        Fintype.linearCombination ℝ (fun i : S ↦ a i.1) '' {ν | ∀ i, 0 ≤ ν i} := by
    ext v
    simp only [mem_ofPred_eq, mem_iUnion, mem_image, Fintype.linearCombination_apply]
    constructor
    · rintro ⟨μ, hμ, rfl⟩
      obtain ⟨ν, hν, hνsum, hνind⟩ := exists_nonneg_linearIndependent_sum_eq a μ hμ
      refine ⟨{i | 0 < ν i}, hνind, fun i ↦ ν i.1, fun i ↦ hν i.1, ?_⟩
      rw [← hνsum, ← Fintype.sum_subtype_add_sum_subtype (fun i ↦ 0 < ν i)]
      have h0 : ∑ i : {i // ¬ 0 < ν i}, ν i.1 • a i.1 = 0 :=
        Finset.sum_eq_zero fun i _ ↦ by
          rw [le_antisymm (not_lt.1 i.2) (hν i.1), zero_smul]
      rw [h0, add_zero]
      rfl
    · rintro ⟨S, -, ν, hν, rfl⟩
      obtain ⟨μ, hμS, hμn⟩ : ∃ μ : ι → ℝ, (∀ i (h : i ∈ S), μ i = ν ⟨i, h⟩) ∧
          ∀ i, i ∉ S → μ i = 0 :=
        ⟨fun i ↦ if h : i ∈ S then ν ⟨i, h⟩ else 0, fun _ h ↦ dif_pos h, fun _ h ↦ dif_neg h⟩
      refine ⟨μ, fun i ↦ ?_, ?_⟩
      · by_cases h : i ∈ S
        · rw [hμS i h]
          exact hν _
        · rw [hμn i h]
      · rw [← Fintype.sum_subtype_add_sum_subtype (fun i ↦ i ∈ S)]
        have h0 : ∑ i : {i // ¬ i ∈ S}, μ i.1 • a i.1 = 0 :=
          Finset.sum_eq_zero fun i _ ↦ by rw [hμn i.1 i.2, zero_smul]
        rw [h0, add_zero]
        exact Fintype.sum_equiv (Equiv.refl _) _ _ fun i ↦ by
          rw [Equiv.refl_apply, hμS i.1 i.2]
  rw [e]
  refine isClosed_iUnion_of_finite fun S ↦ isClosed_iUnion_of_finite fun hS ↦ ?_
  have hker : LinearMap.ker (Fintype.linearCombination ℝ (fun i : S ↦ a i.1)) = ⊥ :=
    LinearMap.ker_eq_bot.2 (linearIndependent_iff_injective_fintypeLinearCombination.1 hS)
  exact (LinearMap.isClosedEmbedding_of_injective hker).isClosedMap _
    (isClosed_Ici (a := (0 : S → ℝ)))

/-- **Farkas' lemma**: in a finite-dimensional normed space, if `c(v) ≥ 0` whenever `aᵢ(v) ≥ 0`
for all `i`, then `c = ∑ μᵢ aᵢ` for some `μ ≥ 0`. -/
theorem exists_nonneg_eq_sum_of_forall_nonneg {F : Type*} [NormedAddCommGroup F]
    [NormedSpace ℝ F] [FiniteDimensional ℝ F] (a : ι → StrongDual ℝ F) (c : StrongDual ℝ F)
    (h : ∀ v : F, (∀ i, 0 ≤ a i v) → 0 ≤ c v) :
    ∃ μ : ι → ℝ, (∀ i, 0 ≤ μ i) ∧ c = ∑ i, μ i • a i := by
  classical
  by_contra hc
  have hconv : Convex ℝ {w : StrongDual ℝ F | ∃ μ : ι → ℝ, (∀ i, 0 ≤ μ i) ∧ w = ∑ i, μ i • a i} := by
    rintro _ ⟨μ, hμ, rfl⟩ _ ⟨ν, hν, rfl⟩ s t hs ht -
    refine ⟨fun i ↦ s * μ i + t * ν i, fun i ↦ by have := hμ i; have := hν i; positivity, ?_⟩
    simp only [add_smul, mul_smul, Finset.sum_add_distrib, Finset.smul_sum]
  obtain ⟨f, u, hfK, hfc⟩ := geometric_hahn_banach_closed_point hconv (isClosed_nonnegSpan a) hc
  have hu : 0 < u := by simpa using hfK 0 ⟨0, fun _ ↦ le_rfl, by simp⟩
  -- `f ≤ 0` on the cone
  have hfa : ∀ i, f (a i) ≤ 0 := fun i ↦ by
    by_contra hpos
    push Not at hpos
    have hmem : (u / f (a i)) • a i ∈
        {w : StrongDual ℝ F | ∃ μ : ι → ℝ, (∀ i, 0 ≤ μ i) ∧ w = ∑ i, μ i • a i} := by
      refine ⟨Pi.single i (u / f (a i)), fun j ↦ ?_, ?_⟩
      · by_cases hj : j = i
        · subst hj
          rw [Pi.single_eq_same]
          exact (div_pos hu hpos).le
        · rw [Pi.single_eq_of_ne hj]
      · rw [Fintype.sum_eq_single i fun j hj ↦ by rw [Pi.single_eq_of_ne hj, zero_smul],
          Pi.single_eq_same]
    have := hfK _ hmem
    rw [map_smul, smul_eq_mul, div_mul_cancel₀ _ hpos.ne'] at this
    exact lt_irrefl _ this
  obtain ⟨v, hv⟩ := VariationalAnalysis.inclusionInDoubleDual_surjective f
  have hfv : ∀ w, f w = w v := fun w ↦ by rw [← hv]; rfl
  have := h (-v) fun i ↦ by rw [map_neg, ← hfv]; linarith [hfa i]
  rw [map_neg, ← hfv] at this
  linarith

end VariationalAnalysis
